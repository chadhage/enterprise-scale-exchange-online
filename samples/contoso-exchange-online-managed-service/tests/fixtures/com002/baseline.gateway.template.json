{
  "$schema": "./exchange-online-secure-baseline.schema.json",
  "metadata": {
    "name": "Contoso Exchange Online secure managed service baseline",
    "version": "2.0.0",
    "deploymentProfile": "ThirdPartyGateway",
    "configurationOwner": "__ADMIN_REQUIRED:CONFIGURATION_OWNER_UPN__"
  },
  "administratorInputs": {
    "tenantId": "__ADMIN_REQUIRED:MICROSOFT_ENTRA_TENANT_GUID__",
    "organizationName": "__ADMIN_REQUIRED:LEGAL_ORGANIZATION_NAME__",
    "primaryDomain": "__ADMIN_REQUIRED:PRIMARY_SMTP_DOMAIN__",
    "securityOperationsMailbox": "__ADMIN_REQUIRED:SECURITY_OPERATIONS_MAILBOX__",
    "proofpointTlsCertificateName": "__ADMIN_REQUIRED:PROOFPOINT_TLS_CERTIFICATE_SUBJECT__",
    "proofpointPublicSendingIpRanges": [
      "__ADMIN_REQUIRED:CURRENT_PROOFPOINT_PUBLIC_IP_OR_CIDR__"
    ],
    "proofpointSmartHosts": [
      "__ADMIN_REQUIRED:PROOFPOINT_OUTBOUND_SMART_HOST_FQDN__"
    ]
  },
  "desiredState": {
    "acceptedDomain": {
      "domainName": "__ADMIN_REQUIRED:PRIMARY_SMTP_DOMAIN__",
      "domainType": "Authoritative"
    },
    "mailFlow": {
      "gateway": {
        "declared": true,
        "vendor": "Proofpoint"
      },
      "gatewayInboundConnector": {
        "enabled": true,
        "senderDomains": ["*"],
        "senderIpAddresses": [
          "__ADMIN_REQUIRED:CURRENT_PROOFPOINT_PUBLIC_IP_OR_CIDR__"
        ]
      },
      "gatewayOutboundConnector": {
        "smartHosts": [
          "__ADMIN_REQUIRED:PROOFPOINT_OUTBOUND_SMART_HOST_FQDN__"
        ],
        "tlsDomain": "__ADMIN_REQUIRED:PROOFPOINT_TLS_CERTIFICATE_SUBJECT__"
      }
    },
    "purviewGovernance": {
      "unifiedAuditLogEnabled": true,
      "auditRetentionDays": 365
    },
    "advancedDelivery": {
      "securityOperationsMailboxes": [
        "__ADMIN_REQUIRED:SECURITY_OPERATIONS_MAILBOX__"
      ]
    }
  }
}
