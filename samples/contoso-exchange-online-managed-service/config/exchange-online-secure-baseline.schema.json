{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contoso.example/schemas/exchange-online-secure-baseline.schema.json",
  "title": "Exchange Online secure managed service baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "licensing", "administratorInputs", "desiredState", "deployment"],
  "properties": {
    "$schema": { "type": "string" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "reviewedOn", "deploymentProfile", "profile", "configurationOwner"],
      "properties": {
        "deploymentProfile": { "enum": ["MicrosoftNative", "ThirdPartyGateway"] }
      }
    },
    "licensing": {
      "type": "object",
      "required": ["requiredServicePlans", "targetValidationMode", "servicePlanProvisioningStateBehavior"],
      "properties": {
        "messagingTier": {
          "description": "Planning metadata only. The tenant service-plan inventory decides entitlement at run time and overrides this value.",
          "enum": ["EOP", "MDO_P1", "MDO_P2"]
        },
        "complianceTier": {
          "description": "Planning metadata only. The tenant service-plan inventory decides entitlement at run time and overrides this value.",
          "enum": ["None", "E3", "E5Compliance"]
        },
        "requiredServicePlans": {
          "description": "The service plans a control needs. Matched against the tenant inventory by identifier, never by display name.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["servicePlanId", "servicePlanName"],
            "properties": {
              "servicePlanId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "servicePlanName": { "type": "string", "minLength": 1 },
              "controls": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "targetValidationMode": {
          "description": "How far the licensing gate reaches: the tenant alone, the tenant and at least one targeted user, or the tenant and every targeted user.",
          "enum": ["TenantOnly", "TenantAndAnyTarget", "TenantAndEveryTarget"]
        },
        "servicePlanProvisioningStateBehavior": {
          "description": "The outcome when an assigned service plan is not enabled. An assigned but non-enabled plan never counts as entitled.",
          "type": "object",
          "additionalProperties": false,
          "required": ["disabled", "suspended", "pending"],
          "properties": {
            "disabled": { "enum": ["TreatAsNotEntitled", "TreatAsFail", "TreatAsError"] },
            "suspended": { "enum": ["TreatAsNotEntitled", "TreatAsFail", "TreatAsError"] },
            "pending": { "enum": ["TreatAsNotEntitled", "TreatAsFail", "TreatAsError"] }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "administratorInputs": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        ]
      }
    },
    "desiredState": {
      "type": "object",
      "required": [
        "acceptedDomain",
        "mailFlow",
        "defenderForOffice365",
        "exchangeOnline",
        "emailAuthentication",
        "centralMonitoring",
        "purviewGovernance"
      ],
      "properties": {
        "acceptedDomain": { "type": "object" },
        "mailFlow": {
          "type": "object",
          "required": ["gateway", "enhancedFiltering", "prohibitedBypass"],
          "properties": {
            "gateway": {
              "type": "object",
              "required": ["declared", "vendor"],
              "properties": {
                "declared": { "type": "boolean" },
                "vendor": { "type": "string", "minLength": 1 },
                "direction": { "enum": ["None", "Inbound", "Outbound", "InboundAndOutbound"] }
              }
            },
            "enhancedFiltering": {
              "type": "object",
              "required": ["enabled"],
              "properties": { "enabled": { "type": "boolean" } }
            },
            "prohibitedBypass": {
              "type": "object",
              "properties": {
                "sclMinusOneTransportRules": { "const": false },
                "directToTenantMxFromInternet": { "const": false }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "gateway": { "properties": { "declared": { "const": true } } } }
              },
              "then": {
                "required": ["gatewayInboundConnector", "gatewayOutboundConnector"],
                "properties": {
                  "enhancedFiltering": { "properties": { "enabled": { "const": true } } }
                }
              },
              "else": {
                "not": {
                  "anyOf": [
                    { "required": ["gatewayInboundConnector"] },
                    { "required": ["gatewayOutboundConnector"] }
                  ]
                }
              }
            }
          ]
        },
        "defenderForOffice365": {
          "type": "object",
          "required": [
            "standardPreset",
            "strictPreset",
            "builtInProtection",
            "quarantinePolicies",
            "impersonationProtection",
            "userSubmissions",
            "advancedDelivery",
            "tenantAllowBlockList"
          ],
          "properties": {
            "safeDocuments": {
              "type": "object",
              "required": ["enabled", "requiredServicePlan"],
              "properties": {
                "enabled": { "type": "boolean" },
                "allowBypass": { "const": false },
                "requiredServicePlan": { "const": "SAFEDOCS" }
              }
            },
            "standardPreset": {
              "type": "object",
              "required": ["enabled", "scope", "sentToDomains", "excludedGroups", "excludedSecOpsMailbox"],
              "properties": {
                "enabled": { "const": true },
                "scope": { "type": "string", "minLength": 1 },
                "sentToDomains": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "excludedGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "excludedSecOpsMailbox": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            },
            "strictPreset": {
              "type": "object",
              "required": ["enabled", "scopeGroup"],
              "properties": {
                "enabled": { "const": true },
                "scopeGroup": { "type": "string", "minLength": 1 }
              }
            },
            "impersonationProtection": {
              "type": "object",
              "required": ["enabled", "protectedUsers", "protectedDomains", "approvedExceptions"],
              "properties": {
                "enabled": { "const": true },
                "protectedUsers": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "protectedDomains": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "approvedExceptions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["exceptionType", "value", "owner", "ticket", "expirationDateTime", "justification"],
                    "properties": {
                      "exceptionType": { "enum": ["TrustedSender", "TrustedDomain"] },
                      "value": { "type": "string", "minLength": 1 },
                      "owner": { "type": "string", "minLength": 1 },
                      "ticket": { "type": "string", "minLength": 1 },
                      "expirationDateTime": { "type": "string", "format": "date-time", "minLength": 1 },
                      "justification": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            },
            "userSubmissions": {
              "type": "object",
              "required": [
                "microsoftReportMessageButton",
                "sendReportedMessagesToMicrosoft",
                "reportingDestination",
                "reportingMailbox"
              ],
              "properties": {
                "microsoftReportMessageButton": { "const": true },
                "sendReportedMessagesToMicrosoft": { "const": true },
                "sendCopyToSecOpsMailbox": { "type": "boolean" },
                "reportingDestination": {
                  "enum": ["MicrosoftOnly", "MicrosoftAndCustomMailbox", "CustomMailboxOnly"]
                },
                "reportingMailbox": { "type": "string", "minLength": 1 }
              }
            },
            "advancedDelivery": {
              "type": "object",
              "required": ["secOpsMailbox"],
              "properties": {
                "secOpsMailbox": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "phishingSimulationOverrides": { "type": "array" }
              }
            },
            "tenantAllowBlockList": {
              "type": "object",
              "required": [
                "registerLocation",
                "allowEntryMaximumDurationDays",
                "blockEntryRetentionDays",
                "requiredEntryFields",
                "blockEntriesRequireExpiryAndTicket"
              ],
              "properties": {
                "registerLocation": { "type": "string", "minLength": 1 },
                "allowEntryMaximumDurationDays": { "type": "integer", "minimum": 1, "maximum": 30 },
                "blockEntryRetentionDays": { "type": "integer", "minimum": 1 },
                "requiredEntryFields": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "entryType",
                      "entryValue",
                      "owner",
                      "ticket",
                      "createdDateTime",
                      "expirationDateTime",
                      "justification"
                    ]
                  }
                },
                "blockEntriesRequireExpiryAndTicket": { "const": true },
                "permanentAllowEntries": { "type": "array", "maxItems": 0 }
              }
            },
            "quarantinePolicies": {
              "type": "object",
              "required": [
                "endUserAccessLevel",
                "highRiskAccessLevel",
                "endUserSpamNotificationFrequencyInDays",
                "categoryPermissions"
              ],
              "properties": {
                "endUserAccessLevel": { "enum": ["AdminOnlyAccess", "LimitedAccess", "FullAccess"] },
                "highRiskAccessLevel": { "const": "AdminOnlyAccess" },
                "highRiskCategories": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "endUserSpamNotificationFrequencyInDays": { "enum": [1, 4, 7] },
                "includeMessagesFromBlockedSenderAddress": { "type": "boolean" },
                "categoryPermissions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["category", "accessLevel"],
                    "properties": {
                      "category": {
                        "enum": [
                          "Malware",
                          "HighConfidencePhish",
                          "Phish",
                          "HighConfidenceSpam",
                          "Spam",
                          "Bulk",
                          "SpoofIntelligence"
                        ]
                      },
                      "accessLevel": { "enum": ["AdminOnlyAccess", "LimitedAccess", "FullAccess"] }
                    }
                  }
                }
              }
            }
          }
        },
        "exchangeOnline": {
          "type": "object",
          "required": [
            "smtpClientAuthenticationDisabled",
            "mailboxAuditingDefault",
            "automaticExternalForwarding",
            "externalSenderIdentification",
            "remoteDomainDefault",
            "protocolRestriction",
            "roleBasedAccessControl",
            "transportSecurity"
          ],
          "properties": {
            "smtpClientAuthenticationDisabled": { "const": true },
            "automaticExternalForwarding": { "const": "Off" }
          }
        },
        "emailAuthentication": { "type": "object" },
        "abnormalSecurity": { "type": "object" },
        "centralMonitoring": { "type": "object" },
        "purviewGovernance": {
          "type": "object",
          "required": ["unifiedAuditLogEnabled", "auditRetentionDays"],
          "properties": {
            "unifiedAuditLogEnabled": { "const": true },
            "auditRetentionDays": { "type": "integer", "minimum": 180 }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "required": ["defaultMode", "requireWhatIfBeforeApply", "pilotRequired", "evidenceOutputDirectory"],
      "properties": {
        "defaultMode": { "const": "Audit" },
        "requireWhatIfBeforeApply": { "const": true },
        "pilotRequired": { "const": true },
        "pilotMinimumBusinessDays": { "type": "integer", "minimum": 5 },
        "rollbackPlanRequired": { "const": true },
        "evidenceOutputDirectory": { "type": "string" }
      }
    }
  }
}
