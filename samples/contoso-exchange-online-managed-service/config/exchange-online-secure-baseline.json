{
  "$schema": "./exchange-online-secure-baseline.schema.json",
  "metadata": {
    "name": "Contoso Exchange Online secure managed service baseline",
    "version": "2.0.0",
    "reviewedOn": "2026-09-16",
    "deploymentProfile": "ThirdPartyGateway",
    "profile": "Microsoft recommended Standard plus Strict for priority users, fronted by a third-party SMTP gateway",
    "configurationOwner": "__ADMIN_REQUIRED:CONFIGURATION_OWNER_UPN__"
  },
  "licensing": {
    "messagingTier": "MDO_P2",
    "complianceTier": "E5Compliance",
    "requiredServicePlans": [
      {
        "servicePlanId": "efb87545-963c-4e0d-99df-69c6916d9eb0",
        "servicePlanName": "EXCHANGE_S_ENTERPRISE",
        "controls": ["EXO-001", "EXO-002", "EXO-004", "EXO-005", "EXO-006", "EXO-007", "EXO-008", "EXO-009"]
      },
      {
        "servicePlanId": "f20fedf3-f3c3-43c3-8267-2bfdd51c0939",
        "servicePlanName": "ATP_ENTERPRISE",
        "controls": ["MDO-001", "MDO-002", "MDO-003", "MDO-004"]
      },
      {
        "servicePlanId": "8e0c0a52-6a6c-4d40-8370-dd62790dcd70",
        "servicePlanName": "THREAT_INTELLIGENCE",
        "controls": ["MDO-003"]
      },
      {
        "servicePlanId": "bf6f5520-59e3-4f82-974b-7dbbc4fd27c7",
        "servicePlanName": "SAFEDOCS",
        "controls": ["MDO-005"]
      },
      {
        "servicePlanId": "2f442157-a11c-46b9-ae5b-6e39ff4e5849",
        "servicePlanName": "M365_ADVANCED_AUDITING",
        "controls": ["GOV-001"]
      }
    ],
    "targetValidationMode": "TenantAndEveryTarget",
    "servicePlanProvisioningStateBehavior": {
      "disabled": "TreatAsNotEntitled",
      "suspended": "TreatAsNotEntitled",
      "pending": "TreatAsNotEntitled"
    },
    "notes": "The tiers are planning metadata. Entitlement is decided from the tenant service-plan inventory, and a plan that is assigned but not enabled is never entitled. Verify every servicePlanId against the Microsoft published product names and service plan identifiers list. See docs/LICENSING-GATE.md."
  },
  "administratorInputs": {
    "tenantId": "__ADMIN_REQUIRED:MICROSOFT_ENTRA_TENANT_GUID__",
    "organizationName": "__ADMIN_REQUIRED:LEGAL_ORGANIZATION_NAME__",
    "primaryDomain": "__ADMIN_REQUIRED:PRIMARY_SMTP_DOMAIN__",
    "initialDomain": "__ADMIN_REQUIRED:INITIAL_ONMICROSOFT_DOMAIN__",
    "securityOperationsMailbox": "__ADMIN_REQUIRED:SECURITY_OPERATIONS_MAILBOX__",
    "priorityUsersGroup": "__ADMIN_REQUIRED:MAIL_ENABLED_PRIORITY_USERS_GROUP__",
    "gatewayInboundConnectorName": "Proofpoint Inbound",
    "gatewayOutboundConnectorName": "Proofpoint Outbound",
    "proofpointPublicSendingIpRanges": [
      "__ADMIN_REQUIRED:CURRENT_PROOFPOINT_PUBLIC_IP_OR_CIDR__"
    ],
    "proofpointTlsCertificateName": "__ADMIN_REQUIRED:PROOFPOINT_TLS_CERTIFICATE_SUBJECT__",
    "proofpointSmartHosts": [
      "__ADMIN_REQUIRED:PROOFPOINT_OUTBOUND_SMART_HOST_FQDN__"
    ],
    "proofpointSpfRecord": "__ADMIN_REQUIRED:PROOFPOINT_APPROVED_SPF_RECORD__",
    "abnormalTenantIdentifier": "__ADMIN_REQUIRED:ABNORMAL_TENANT_OR_PORTAL_IDENTIFIER__",
    "siemPlatform": "__ADMIN_REQUIRED:CENTRAL_SIEM_PLATFORM__",
    "changeRecord": "__ADMIN_REQUIRED:APPROVED_CHANGE_RECORD__"
  },
  "desiredState": {
    "acceptedDomain": {
      "domainName": "__ADMIN_REQUIRED:PRIMARY_SMTP_DOMAIN__",
      "domainType": "Authoritative"
    },
    "mailFlow": {
      "gateway": {
        "declared": true,
        "vendor": "Proofpoint",
        "direction": "InboundAndOutbound"
      },
      "mxTarget": "__ADMIN_REQUIRED:PROOFPOINT_MX_TARGET__",
      "inboundPath": "Internet -> Proofpoint -> Exchange Online Protection -> Exchange Online",
      "outboundPath": "Exchange Online -> Proofpoint -> Internet",
      "gatewayInboundConnector": {
        "connectorType": "Partner",
        "enabled": true,
        "senderDomains": ["*"],
        "requireTls": true,
        "restrictDomainsToIpAddresses": true,
        "restrictDomainsToCertificate": false,
        "senderIpAddresses": [
          "__ADMIN_REQUIRED:CURRENT_PROOFPOINT_PUBLIC_IP_OR_CIDR__"
        ]
      },
      "enhancedFiltering": {
        "enabled": true,
        "skipLastIp": false,
        "skipIpAddresses": [
          "__ADMIN_REQUIRED:ALL_NON_MICROSOFT_PUBLIC_HOP_IPS_OR_CIDRS__"
        ],
        "applyToAllRecipients": true
      },
      "gatewayOutboundConnector": {
        "connectorType": "Partner",
        "enabled": true,
        "recipientDomains": ["*"],
        "routeAllMessagesViaOnPremises": true,
        "useMxRecord": false,
        "smartHosts": [
          "__ADMIN_REQUIRED:PROOFPOINT_OUTBOUND_SMART_HOST_FQDN__"
        ],
        "tlsSettings": "DomainValidation",
        "tlsDomain": "__ADMIN_REQUIRED:PROOFPOINT_TLS_CERTIFICATE_SUBJECT__"
      },
      "prohibitedBypass": {
        "sclMinusOneTransportRules": false,
        "directToTenantMxFromInternet": false,
        "ipAllowListForProofpoint": false
      }
    },
    "defenderForOffice365": {
      "standardPreset": {
        "enabled": true,
        "scope": "AllRecipientsExceptStrictAndSecOps"
      },
      "strictPreset": {
        "enabled": true,
        "scopeGroup": "__ADMIN_REQUIRED:MAIL_ENABLED_PRIORITY_USERS_GROUP__"
      },
      "builtInProtection": {
        "enabled": true,
        "exceptions": []
      },
      "safeAttachmentsForSharePointOneDriveTeams": true,
      "safeDocuments": {
        "enabled": true,
        "allowBypass": false,
        "requiredServicePlan": "SAFEDOCS",
        "licenseRequired": "Microsoft 365 E5/A5/G5 or Microsoft Defender Suite"
      },
      "zeroHourAutoPurge": true,
      "quarantinePolicies": {
        "endUserAccessLevel": "LimitedAccess",
        "highRiskAccessLevel": "AdminOnlyAccess",
        "highRiskCategories": ["Malware", "HighConfidencePhish"],
        "endUserSpamNotificationFrequencyInDays": 1,
        "includeMessagesFromBlockedSenderAddress": false
      },
      "userSubmissions": {
        "microsoftReportMessageButton": true,
        "sendReportedMessagesToMicrosoft": true,
        "sendCopyToSecOpsMailbox": true
      },
      "tenantAllowBlockList": {
        "permanentAllowEntries": [],
        "blockEntriesRequireExpiryAndTicket": true
      }
    },
    "exchangeOnline": {
      "smtpClientAuthenticationDisabled": true,
      "externalPostmasterAddress": "__ADMIN_REQUIRED:EXTERNAL_POSTMASTER_SMTP_ADDRESS__",
      "mailboxAuditingDefault": true,
      "mailboxAuditBypassAssociations": [],
      "modernAuthenticationRequired": true,
      "legacyAuthenticationBlockedByConditionalAccess": true,
      "automaticExternalForwarding": "Off",
      "remoteDomainAutoForwardEnabled": false,
      "externalSenderIdentification": {
        "enabled": true,
        "allowList": []
      },
      "remoteDomainDefault": {
        "autoForwardEnabled": false,
        "autoReplyEnabled": false,
        "allowedOOFType": "InternalLegacy",
        "deliveryReportEnabled": false,
        "nonDeliveryReportEnabled": false
      },
      "protocolRestriction": {
        "ewsEnabled": false,
        "ewsAllowList": [],
        "popEnabledByDefault": false,
        "imapEnabledByDefault": false,
        "outlookAddInsForUsers": false
      },
      "roleBasedAccessControl": {
        "noStandingGlobalAdministratorForMessaging": true,
        "privilegedRolesJustInTime": true,
        "roleGroupReviewFrequencyDays": 90,
        "approvedRoleGroups": [
          "Organization Management",
          "Security Administrator",
          "Security Reader",
          "View-Only Organization Management"
        ]
      },
      "transportSecurity": {
        "mtaStsMode": "enforce",
        "mtaStsMaxAgeSeconds": 604800,
        "tlsRptEnabled": true,
        "tlsRptAddress": "__ADMIN_REQUIRED:TLS_RPT_REPORTING_ADDRESS__"
      }
    },
    "emailAuthentication": {
      "dkim": {
        "enabled": true,
        "keySize": 2048,
        "selector1Cname": "__ADMIN_REQUIRED:VALUE_RETURNED_BY_GET_DKIMSIGNINGCONFIG__",
        "selector2Cname": "__ADMIN_REQUIRED:VALUE_RETURNED_BY_GET_DKIMSIGNINGCONFIG__"
      },
      "spf": {
        "record": "__ADMIN_REQUIRED:PROOFPOINT_APPROVED_SPF_RECORD__",
        "hardFail": true,
        "singleRecordOnly": true
      },
      "dmarc": {
        "policy": "reject",
        "percentage": 100,
        "aggregateReportAddress": "__ADMIN_REQUIRED:DMARC_AGGREGATE_REPORTING_ADDRESS__",
        "forensicReportAddress": "__ADMIN_REQUIRED:DMARC_FORENSIC_REPORTING_ADDRESS_OR_NOT_APPLICABLE__",
        "subdomainPolicy": "reject",
        "dkimAlignment": "relaxed",
        "spfAlignment": "relaxed"
      },
      "trustedArcSealers": [
        "__ADMIN_REQUIRED:PROOFPOINT_ARC_SEALING_DOMAIN_OR_NOT_SUPPORTED__"
      ]
    },
    "abnormalSecurity": {
      "integrationMode": "Microsoft API post-delivery",
      "smtpConnectorCreated": false,
      "transportBypassCreated": false,
      "servicePrincipalUsesLeastPrivilege": true,
      "vendorHealthMonitoringEnabled": true,
      "permissionReviewFrequencyDays": 90
    },
    "centralMonitoring": {
      "defenderXdrIncidentQueue": true,
      "unifiedAuditLog": true,
      "exchangeAdminAudit": true,
      "messageTrace": true,
      "mailFlowReports": true,
      "threatProtectionStatusReport": true,
      "siemIntegration": {
        "enabled": true,
        "destination": "__ADMIN_REQUIRED:CENTRAL_SIEM_PLATFORM__",
        "sources": [
          "Microsoft Defender XDR incidents and alerts",
          "Office 365 audit logs",
          "Exchange admin audit events",
          "Microsoft Entra sign-in and audit logs",
          "Proofpoint alerts and message telemetry",
          "Abnormal Security cases and remediation events"
        ],
        "minimumRetentionDays": 180,
        "alertRecipients": [
          "__ADMIN_REQUIRED:SECURITY_OPERATIONS_MAILBOX__"
        ]
      },
      "serviceHealthNotifications": true,
      "dailyOperationalReview": true,
      "weeklyControlDriftReview": true,
      "quarterlyAccessReview": true
    },
    "purviewGovernance": {
      "unifiedAuditLogEnabled": true,
      "auditRetentionDays": 365,
      "exchangeDlpPolicyRequired": true,
      "exchangeDlpPolicyName": "__ADMIN_REQUIRED:EXCHANGE_DLP_POLICY_NAME__",
      "mailboxRetentionPolicyRequired": true,
      "mailboxRetentionPolicyName": "__ADMIN_REQUIRED:MAILBOX_RETENTION_POLICY_NAME__",
      "litigationHoldRequiredForPriorityUsers": true,
      "informationRightsManagementEnabled": true,
      "sensitivityLabelsPublished": true,
      "ediscoveryCaseOwners": [
        "__ADMIN_REQUIRED:EDISCOVERY_CASE_OWNER_UPN__"
      ]
    }
  },
  "deployment": {
    "defaultMode": "Audit",
    "requireWhatIfBeforeApply": true,
    "pilotRequired": true,
    "pilotMinimumBusinessDays": 5,
    "rollbackPlanRequired": true,
    "evidenceOutputDirectory": "./evidence"
  }
}