{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "controls"],
  "properties": {
    "$schema": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["deploymentProfile", "version", "reviewedOn"], "properties": { "deploymentProfile": { "const": "ExchangeOnly" }, "version": { "const": "1.0.0" }, "reviewedOn": { "type": "string", "format": "date" } } },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "EXO-001": { "type": "object", "properties": { "domainType": { "enum": ["Authoritative", "InternalRelay"] } } },
        "EXO-002": { "type": "object", "properties": { "smtpClientAuthenticationDisabled": { "type": "boolean" } } },
        "EXO-004": { "type": "object", "properties": { "automaticExternalForwarding": { "enum": ["Off", "On", "Automatic"] } } },
        "EXO-005": { "type": "object", "properties": { "address": { "$ref": "#/$defs/text" } } },
        "EXO-006": { "type": "object", "properties": { "mailboxAuditingDefault": { "type": "boolean" } } },
        "EXO-007": { "type": "object", "properties": { "allowList": { "$ref": "#/$defs/strings" } } },
        "EXO-008": { "type": "object", "properties": { "autoForwardEnabled": { "type": "boolean" }, "autoReplyEnabled": { "type": "boolean" }, "allowedOOFType": { "enum": ["None", "External"] }, "externalReplyApproval": { "type": "string", "pattern": "\\S" }, "deliveryReportEnabled": { "type": "boolean" }, "nonDeliveryReportEnabled": { "type": "boolean" } }, "allOf": [{ "if": { "required": ["allowedOOFType"], "properties": { "allowedOOFType": { "const": "External" } } }, "then": { "required": ["externalReplyApproval"] } }] },
        "EXO-009": {
          "type": "object",
          "properties": {
            "ewsEnabled": { "type": "boolean" },
            "ewsApplicationAccessPolicy": { "const": "EnforceAllowList" },
            "ewsAllowList": { "$ref": "#/$defs/strings" },
            "ewsAllowedAppIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" } },
            "ewsException": {
              "type": "object", "additionalProperties": false,
              "required": ["owner", "approval", "expiresAt", "cloud", "rollback", "clientImpact"],
              "properties": {
                "owner": { "type": "string", "pattern": "\\S" },
                "approval": { "type": "string", "pattern": "\\S" },
                "expiresAt": { "type": "string", "format": "date-time" },
                "cloud": { "const": "Worldwide" },
                "rollback": { "const": "DisableEws" },
                "clientImpact": { "type": "string", "pattern": "\\S" }
              }
            },
            "popEnabledByDefault": { "type": "boolean" },
            "imapEnabledByDefault": { "type": "boolean" },
            "outlookAddInsForUsers": { "type": "boolean" }
          },
          "allOf": [{ "if": { "required": ["ewsEnabled"], "properties": { "ewsEnabled": { "const": true } } }, "then": { "required": ["ewsApplicationAccessPolicy", "ewsAllowList", "ewsAllowedAppIds", "ewsException"], "properties": { "ewsAllowList": { "minItems": 1 } } } }]
        },
        "EXO-010": { "type": "object", "properties": { "approvedRoleGroups": { "$ref": "#/$defs/strings" }, "approvedMembers": { "$ref": "#/$defs/strings" }, "approval": { "$ref": "#/$defs/governanceApproval" }, "assignments": { "type": "array", "items": { "type": "object" } }, "scopes": { "type": "array", "items": { "type": "object" } }, "mailboxPolicies": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["mailbox","policy"], "properties": { "mailbox": { "$ref": "#/$defs/text" }, "policy": { "$ref": "#/$defs/text" } } } }, "effectiveUsers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["assignment","user"], "properties": { "assignment": { "$ref": "#/$defs/text" }, "user": { "$ref": "#/$defs/text" } } } } } },
        "EXO-012": { "type": "object", "properties": { "outlookAddInsForUsers": { "type": "boolean" } } },
        "MDO-001": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "sentToDomains": { "$ref": "#/$defs/strings" }, "excludedGroups": { "$ref": "#/$defs/strings" }, "excludedSecOpsMailbox": { "$ref": "#/$defs/strings" }, "approval": { "$ref": "#/$defs/governanceApproval" }, "recipientMatrix": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["address","level","defender","expectedPolicy"], "properties": { "address": { "$ref": "#/$defs/text" }, "level": { "enum": ["Standard","Strict"] }, "defender": { "type": "boolean" }, "expectedPolicy": { "$ref": "#/$defs/text" } } } }, "settingExceptions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["recipient","family","setting","value","approval"], "properties": { "recipient": { "$ref": "#/$defs/text" }, "family": { "$ref": "#/$defs/text" }, "setting": { "$ref": "#/$defs/text" }, "value": {}, "approval": { "$ref": "#/$defs/governanceApproval" } } } } } },
        "MDO-002": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "scopeGroup": { "$ref": "#/$defs/text" } } },
        "MDO-003": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "exceptions": { "$ref": "#/$defs/strings" } } },
        "MDO-006": { "type": "object", "properties": { "microsoftReportMessageButton": { "type": "boolean" }, "sendReportedMessagesToMicrosoft": { "type": "boolean" }, "sendCopyToSecOpsMailbox": { "type": "boolean" }, "reportingDestination": { "$ref": "#/$defs/text" }, "reportingMailbox": { "$ref": "#/$defs/text" }, "approval": { "$ref": "#/$defs/governanceApproval" }, "preSubmitMessageEnabled": { "type": "boolean" }, "postSubmitMessageEnabled": { "type": "boolean" } } },
        "MDO-007": { "type": "object", "properties": { "permanentAllowEntries": { "type": "array", "maxItems": 0 }, "blockEntriesRequireExpiryAndTicket": { "type": "boolean" }, "allowEntryMaximumDurationDays": { "$ref": "#/$defs/days" }, "blockEntryRetentionDays": { "$ref": "#/$defs/days" }, "requiredEntryFields": { "$ref": "#/$defs/strings" } } },
        "MDO-008": { "type": "object", "properties": { "endUserAccessLevel": { "$ref": "#/$defs/text" }, "highRiskAccessLevel": { "$ref": "#/$defs/text" }, "highRiskCategories": { "$ref": "#/$defs/strings" }, "endUserSpamNotificationFrequencyInDays": { "$ref": "#/$defs/days" }, "includeMessagesFromBlockedSenderAddress": { "type": "boolean" }, "categoryPermissions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["category", "accessLevel"], "properties": { "category": { "$ref": "#/$defs/text" }, "accessLevel": { "$ref": "#/$defs/text" } } } } } },
        "MDO-009": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "protectedUsers": { "$ref": "#/$defs/strings" }, "protectedDomains": { "$ref": "#/$defs/strings" }, "approvedExceptions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["exceptionType", "value", "owner", "ticket", "expiresOn"], "properties": { "exceptionType": { "enum": ["TrustedSender", "TrustedDomain"] }, "value": { "$ref": "#/$defs/text" }, "owner": { "$ref": "#/$defs/text" }, "ticket": { "$ref": "#/$defs/text" }, "expiresOn": { "type": "string", "format": "date-time" } } } } } },
        "PP-005": { "type": "object", "properties": { "enabledPartnerConnectors": { "const": false } } },
        "AUTH-001": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "keySize": { "enum": [1024, 2048] } } },
        "MON-003": { "type": "object", "properties": { "scheduledCollectionEnabled": { "type": "boolean" }, "collectionFrequencyHours": { "$ref": "#/$defs/days" }, "minimumRetentionDays": { "$ref": "#/$defs/days" }, "maximumEvidenceAgeHours": { "$ref": "#/$defs/days" }, "requireSignedEvidence": { "const": true } } },
        "OPS-001": { "type": "object", "properties": { "maximumEvidenceAgeHours": { "$ref": "#/$defs/days" }, "requireSignedEvidence": { "const": true }, "requirePreview": { "const": true }, "requirePilot": { "const": true }, "requireApproval": { "const": true }, "requireRollback": { "const": true }, "requirePostChange": { "const": true } } },
        "OPS-002": { "type": "object", "properties": { "requiredServicePlan": { "const": "EXCHANGE_S_ENTERPRISE" }, "frequencyDays": { "$ref": "#/$defs/days" }, "exerciseTypes": { "$ref": "#/$defs/strings" }, "owners": { "$ref": "#/$defs/strings" }, "requireTrackedActions": { "const": true }, "maximumEvidenceAgeDays": { "$ref": "#/$defs/days" } } },
        "GOV-003": { "type": "object", "properties": { "policyName": { "$ref": "#/$defs/text" }, "policyType": { "const": "ExchangeMRM" }, "approval": { "$ref": "#/$defs/governanceApproval" }, "tags": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name","type","action","ageDays","enabled"], "properties": { "name": { "$ref": "#/$defs/text" }, "type": { "$ref": "#/$defs/text" }, "action": { "enum": ["DeleteAndAllowRecovery","PermanentlyDelete","MoveToArchive","MoveToDeletedItems","MarkAsPastRetentionLimit"] }, "ageDays": { "type": "integer", "minimum": 0 }, "enabled": { "type": "boolean" } } } }, "maximumProcessingAgeDays": { "$ref": "#/$defs/days" }, "mailboxEntitlement": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["identity","archive"], "properties": { "identity": { "$ref": "#/$defs/text" }, "archive": { "type": "boolean" } } } } } },
        "GOV-004": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "custodians": { "$ref": "#/$defs/strings" }, "approval": { "$ref": "#/$defs/governanceApproval" }, "minimumRecoverableItemsFreeBytes": { "type": ["integer","null"], "minimum": 1 }, "holds": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["mailbox","durationDays","owner","mailboxClass","entitled"], "properties": { "mailbox": { "$ref": "#/$defs/text" }, "durationDays": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "Unlimited" }] }, "owner": { "$ref": "#/$defs/text" }, "mailboxClass": { "enum": ["Active","Inactive","SoftDeleted"] }, "entitled": { "type": "boolean" } } } } } },
        "GOV-005": { "type": "object", "properties": { "internalLicensingEnabled": { "type": "boolean" }, "azureRmsLicensingEnabled": { "type": "boolean" }, "transportDecryptionSetting": { "enum": ["Disabled", "Optional", "Mandatory"] }, "journalReportDecryptionEnabled": { "type": "boolean" }, "approval": { "$ref": "#/$defs/governanceApproval" }, "decryptionApproval": { "type": ["object","null"], "additionalProperties": false, "required": ["transport","journal"], "properties": { "transport": { "enum": ["Disabled","Optional","Mandatory"] }, "journal": { "type": "boolean" } } }, "messageClasses": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name","rule","header","recipients","template","sender","entitled"], "properties": { "name": { "$ref": "#/$defs/text" }, "rule": { "$ref": "#/$defs/text" }, "header": { "$ref": "#/$defs/text" }, "recipients": { "$ref": "#/$defs/strings" }, "template": { "$ref": "#/$defs/text" }, "sender": { "$ref": "#/$defs/text" }, "entitled": { "type": "boolean" } } } } } }
      }
    }
  },
  "$defs": {
    "governanceApproval": { "type": ["object","null"], "additionalProperties": false, "required": ["reference","owner","expiresOn"], "properties": { "reference": { "$ref": "#/$defs/text" }, "owner": { "$ref": "#/$defs/text" }, "expiresOn": { "type": "string", "format": "date-time" } } },
    "text": { "type": "string", "minLength": 1 },
    "strings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "days": { "type": "integer", "minimum": 1 }
  }
}